rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Viewer saved library subcollection
      match /saved_resources/{savedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Username reservation collection
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Resources
    match /resources/{resourceId} {
      allow read: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                  || (resource.data.status == 'active');

      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid;

      allow update: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || (
                      resource.data.status == 'active' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['totalViews', 'uniqueViews', 'totalDownloads', 'lastAccessedAt']) &&
                      (request.resource.data.totalViews == resource.data.totalViews || request.resource.data.totalViews == resource.data.totalViews + 1) &&
                      (request.resource.data.uniqueViews == resource.data.uniqueViews || request.resource.data.uniqueViews == resource.data.uniqueViews + 1) &&
                      (request.resource.data.totalDownloads == resource.data.totalDownloads || request.resource.data.totalDownloads == resource.data.totalDownloads + 1)
                    );

      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;

      // Subcollection for chunked storage fallback
      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
      }
    }

    // Audit logs for views
    match /resource_views/{viewId} {
      allow create: if request.resource.data.keys().hasOnly(['resourceId', 'creatorId', 'visitorId', 'viewedAt', 'isUnique'])
                    && request.resource.data.resourceId is string
                    && request.resource.data.creatorId is string
                    && request.resource.data.visitorId is string
                    && request.resource.data.viewedAt is number
                    && request.resource.data.viewedAt >= request.time.toMillis() - 120000
                    && request.resource.data.viewedAt <= request.time.toMillis() + 120000
                    && request.resource.data.isUnique is bool;
      allow read: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Audit logs for downloads
    match /resource_downloads/{downloadId} {
      allow create: if request.resource.data.keys().hasOnly(['resourceId', 'creatorId', 'visitorId', 'downloadedAt'])
                    && request.resource.data.resourceId is string
                    && request.resource.data.creatorId is string
                    && request.resource.data.visitorId is string
                    && request.resource.data.downloadedAt is number
                    && request.resource.data.downloadedAt >= request.time.toMillis() - 120000
                    && request.resource.data.downloadedAt <= request.time.toMillis() + 120000;
      allow read: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
